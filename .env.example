# --- Telegram ---
# Токен, полученный от @BotFather
BOT_TOKEN=
# Ваш Telegram user_id (узнать можно у @userinfobot). Нужен для бэкапов и отчетов.
ADMIN_ID=

# --- Логирование ---
# Уровень логов (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- GigaChat API ---
# Готовый Authorization Key из личного кабинета Sber Developer (Base64)
GIGACHAT_CREDENTIALS=
# Область доступа (GIGACHAT_API_PERS для физлиц)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель (GigaChat-2, GigaChat-2-Lite и т.д.)
GIGACHAT_MODEL=GigaChat-2

# --- Whisper (Локальное распознавание речи) ---
# Путь к бинарнику whisper-cli
WHISPER_CLI=/home/kvg/whisper.cpp/build/bin/whisper-cli
# Путь к файлу модели (base)
WHISPER_MODEL=/home/kvg/whisper.cpp/models/ggml-base.bin

# --- MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=botuser
DB_PASSWORD=
DB_NAME=universal_bot
