0;28;22M0;28;22m"""Клиент GigaChat: OAuth, чат, история на пользователя."""
65;39;17M65;39;17M65;39;16M65;39;16M65;39;15M65;40;14M65;40;14M65;40;13M65;41;13M65;41;12M65;39;19M;5u
import asyncio
import logging

from gigachat import GigaChat
from gigachat.models import Chat, Messages, MessagesRole

from app.config import settings

logger = logging.getLogger(__name__)

SYSTEM_PROMPT = (
    "Ты дружелюбный помощник. Отвечай кратко, по делу, на русском языке."
)
MAX_USER_LEN = 2000
MAX_AI_LEN = 4000
MAX_HISTORY = 20  # 10 пар юзер/ассистент

_client: GigaChat | None = None
_histories: dict[int, list[Messages]] = {}


def _get_client() -> GigaChat:
    global _client
    if _client is None:
        _client = GigaChat(
            credentials=(
                f"{settings.gigachat_client_id}:"
                f"{settings.gigachat_client_secret}"
            ),
            scope=settings.gigachat_scope,
            model=settings.gigachat_model,
            verify_ssl_certs=False,
            timeout=60,
        )
    return _client


def is_configured() -> bool:
    return bool(
        settings.gigachat_client_id and settings.gigachat_client_secret
    )


def reset_history(user_id: int) -> None:
    _histories.pop(user_id, None)


def _get_history(user_id: int) -> list[Messages]:
    if user_id not in _histories:
        _histories[user_id] = [
            Messages(role=MessagesRole.SYSTEM, content=SYSTEM_PROMPT)
        ]
    return _histories[user_id]


async def ask(user_id: int, text: str) -> str:
    if not is_configured():
        raise RuntimeError("GigaChat не настроен (проверьте .env)")

    text = text[:MAX_USER_LEN]
    history = _get_history(user_id)
    history.append(Messages(role=MessagesRole.USER, content=text))

    try:
        client = _get_client()
        response = await asyncio.to_thread(
            client.chat,
            Chat(
                messages=history,
                temperature=0.7,
                max_tokens=1024,
            ),
        )
        answer = response.choices[0].message.content or ""
    except Exception as e:
        logger.exception("GigaChat: ошибка запроса")
        history.pop()  # откатить сообщение пользователя
        raise RuntimeError(f"GigaChat: {e}") from e

    history.append(Messages(role=MessagesRole.ASSISTANT, content=answer))

    # Обрезка: system + последние MAX_HISTORY
    if len(history) > MAX_HISTORY + 1:
        _histories[user_id] = [history[0]] + history[-MAX_HISTORY:]

    return answer[:MAX_AI_LEN]


async def ping() -> tuple[bool, str]:
    if not is_configured():
        return False, "не настроен"
    try:
        client = _get_client()
        response = await asyncio.to_thread(
            client.chat,
            Chat(
                messages=[
                    Messages(role=MessagesRole.USER, content="ок"),
                ],
                max_tokens=10,
            ),
        )
        _ = response.choices[0].message.content
        return True, "ok"
    except Exception as e:
        return False, str(e)[:120]

